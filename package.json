{
  "name": "fc-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for the pastry chef app: products, recipes and food cost.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "PORT=4000 node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "seed": "knex seed:run",
    "catalog:import": "node scripts/import-catalog.js",
    "test": "node --env-file=test/test.env --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jose": "6.2.12",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
