# Copy to .env and adjust.
PORT=3000

# Comma-separated list of allowed origins for the web app, or * for any.
CORS_ORIGIN=*

# Supabase project URL (Project Settings -> API). Required: every /api/v1 request must carry an
# access token from Supabase Auth (Google login), and the API checks it against this project's keys.
SUPABASE_URL=

# Leave empty to use a local SQLite file (data/dev.sqlite3).
# Set to a PostgreSQL connection string to use Postgres, e.g. Supabase:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Set to true to read /api/v1/catalog without logging in. For local work only; leave it off in production.
# CATALOG_PUBLIC=true

# Local SQLite file used when DATABASE_URL is empty (default data/dev.sqlite3).
# SQLITE_FILE=data/local.sqlite3

# SSL is on by default for PostgreSQL. Set to false for a local Postgres without SSL.
# DATABASE_SSL=false

# Only for the migration that added user accounts: the user id that should own data created
# before that migration. Not needed for an empty database.
# LEGACY_OWNER_ID=
